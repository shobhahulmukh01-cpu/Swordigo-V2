{
  "name": "emberwake-sequel-upgrade",
  "version": "1.2.0-alpha.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/prepare-emberwake.mjs && node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/release.test.mjs tests/emberwake-upgrade.test.cjs tests/emberwake-routes.test.cjs tests/emberwake-encounters.test.cjs tests/emberwake-journal.test.cjs",
    "test:campaign": "node tests/emberwake-qa.js && node tests/difficulty-matrix.cjs",
    "test:browser": "python3 tests/browser-smoke.py",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:lumen": "node --test tests/lumen.test.mjs",
    "test:lumen:browser": "node tests/lumen-browser.mjs",
    "test:lumen:campaign": "node tests/lumen-campaign.mjs",
    "build:prototype": "node scripts/bundle.mjs",
    "test:prototype": "node --test tests/lumen.test.mjs",
    "test:upgrade:browser": "node tests/emberwake-upgrade-browser.mjs",
    "test:persistence:browser": "node tests/emberwake-persistence-browser.mjs",
    "test:update:browser": "node tests/emberwake-update-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.25.12",
    "three": "0.186.1"
  }
}
